# Copy this file to .env and fill in the values.
# Only the REQUIRED section must be set to start the app locally; placeholder values are fine
# for the keys that say so.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

ENV=local
DEBUG=True
DJANGO_SECRET_KEY=any-long-random-string-for-local-dev
DJANGO_SETTINGS_MODULE=boardGames.local_settings

# Database (defaults match the Readme setup; with Docker, DB_HOST=db comes from .env_docker)
DB_NAME=boardgamers
DB_USER=bg_user
DB_PASSWORD=bg_password
DB_HOST=localhost
DB_PORT=5432

# Uploaded images (covers, avatars, logos) go to an S3 bucket. Placeholders let the app start,
# but uploads will fail without real credentials.
AWS_S3_ACCESS_KEY_ID=placeholder
AWS_S3_SECRET_ACCESS_KEY=placeholder

# reCAPTCHA v2. Placeholders let the app start; the forms that use it won't validate without
# real keys.
RECAPTCHA_PUBLIC_KEY=placeholder
RECAPTCHA_PRIVATE_KEY=placeholder

# GDAL & GEOS libraries. These are the Linux paths; on macOS remove them to use the defaults in
# boardGames/local_settings.py, or point them at your libgdal.dylib / libgeos_c.dylib.
GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so
GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Google Maps API key
MAPS_API_KEY=

# Google OAuth2 login
GOOGLE_OAUTH2_KEY=
GOOGLE_OAUTH2_SECRET=

# Email via SMTP, e.g. a Mailtrap sandbox (see the Readme)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=2525

# AWS SES (production email only)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# Telegram bot and mini app
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Web push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=

# BoardGameGeek API
BGG_API_TOKEN=
